# Copy this file to backend/.env. Use a long random value for JWT_SECRET.
NODE_ENV=development
DATABASE_URL=postgresql://eventnest:eventnest@localhost:5432/eventnest
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
ADMIN_EMAIL=admin@eventnest.local
ADMIN_PASSWORD=change-this-local-admin-password
AUTH_PORT=4001
EVENTS_PORT=4002
PREFERENCES_PORT=4003
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=info
